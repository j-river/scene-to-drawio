{
  "name": "scene-to-drawio",
  "version": "0.1.0",
  "description": "Turn structured scene JSON into editable Draw.io nodes, labels and bound connectors in browsers and Node.js.",
  "type": "module", "license": "MIT", "author": "j-river",
  "homepage": "https://editableimage.com/",
  "repository": { "type": "git", "url": "git+https://github.com/j-river/scene-to-drawio.git" },
  "bugs": { "url": "https://github.com/j-river/scene-to-drawio/issues" },
  "keywords": ["drawio", "diagrams-net", "diagram", "scene", "mxgraph", "typescript", "export"],
  "engines": { "node": ">=22" },
  "main": "./dist/index.cjs", "module": "./dist/index.js", "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./browser": { "types": "./dist/index.d.ts", "default": "./dist/browser.js" },
    "./package.json": "./package.json"
  },
  "bin": { "scene-to-drawio": "./dist/cli.js" },
  "files": ["dist/index.js", "dist/index.cjs", "dist/index.d.ts", "dist/index.d.cts", "dist/browser.js", "dist/cli.js", "README.md", "LICENSE", "CHANGELOG.md"],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p tests/types/tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm run typecheck && npm test",
    "test:package": "node scripts/test-package.mjs",
    "demo": "node scripts/serve-demo.mjs",
    "build:space": "tsc -p space/tsconfig.json && node scripts/build-space.mjs",
    "demo:space": "node scripts/serve-space.mjs",
    "test:space": "npm run build:space && node scripts/test-space.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": { "@types/node": "24.10.0", "@xmldom/xmldom": "0.9.12", "esbuild": "0.28.2", "typescript": "5.9.3" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" }
}
